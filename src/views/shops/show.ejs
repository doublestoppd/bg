<%- include('../partials/header') %>

<div class="illustration-box shop-header">
  <%- include('../partials/picture', { src: shop.headerImage, alt: shop.name, cssClass: 'shop-banner', width: 320, height: 120 }) %>
  <div class="shop-keeper-row">
    <%- include('../partials/picture', { src: shop.keeper.image, alt: shop.keeper.name, cssClass: 'shop-keeper-portrait', width: 90, height: 90 }) %>
    <div class="shop-keeper"><strong><%= shop.keeper.name %>:</strong> &ldquo;<%= keeperLine %>&rdquo;</div>
  </div>
</div>

<p><%= shop.description %></p>
<p>You have <strong><%= currentUser.coins %></strong> coins.</p>

<h2 class="section-title">Always in stock</h2>
<ul class="item-grid">
  <% for (const offer of essentials) { %>
  <li class="item-box rarity-<%= offer.item.rarity %>">
    <%- include('../partials/item-card-top', { item: offer.item }) %>
    <div class="price"><%= offer.price %> coins each</div>
    <form method="post" action="/shops/<%= shop.id %>/buy" class="buy-form">
      <%- include('../partials/csrf') %>
      <input type="hidden" name="request_id" value="<%= offer.requestId %>">
      <input type="hidden" name="item" value="<%= offer.item.id %>">
      <input type="hidden" name="shown_price" value="<%= offer.price %>">
      <label class="visually-hidden" for="qty-<%= offer.item.id %>">Quantity</label>
      <input type="number" id="qty-<%= offer.item.id %>" name="quantity" value="1" min="1" max="<%= offer.maxQuantity %>" required>
      <button type="submit">Buy</button>
    </form>
  </li>
  <% } %>
</ul>

<h2 class="section-title">On the shelves today</h2>
<p class="muted restock-message"><%= restockMessage %></p>
<div class="notice notice-success shelves-changed" hidden>
  <p>The shelves have changed since this page was loaded. <a href="/shops/<%= shop.id %>">Have a look</a>.</p>
</div>
<% if (!paused && listings.length === 0) { %>
<p class="muted">The shelves are bare. <%= shop.keeper.name %> mutters something about a delivery.</p>
<% } else if (!paused) { %>
<ul class="item-grid shelves" data-shop="<%= shop.id %>" data-restock="<%= currentRestockId %>">
  <% for (const listing of listings) { %>
  <li class="item-box rarity-<%= listing.rarity %><%= listing.remaining_quantity === 0 ? ' sold-out' : '' %>" data-listing="<%= listing.id %>">
    <%- include('../partials/item-card-top', { item: listing }) %>
    <div class="price"><%= listing.unit_price %> coins each</div>
    <% if (listing.remaining_quantity === 0) { %>
    <div class="stock-count sold-out-label">Sold out</div>
    <% } else { %>
    <div class="stock-count"><span class="remaining"><%= listing.remaining_quantity %></span> left</div>
    <form method="post" action="/shops/<%= shop.id %>/buy" class="buy-form">
      <%- include('../partials/csrf') %>
      <input type="hidden" name="request_id" value="<%= listing.requestId %>">
      <input type="hidden" name="listing" value="<%= listing.id %>">
      <input type="hidden" name="shown_price" value="<%= listing.unit_price %>">
      <label class="visually-hidden" for="qty-listing-<%= listing.id %>">Quantity</label>
      <input type="number" id="qty-listing-<%= listing.id %>" name="quantity" value="1" min="1" max="<%= listing.maxQuantity %>" required>
      <button type="submit">Buy</button>
    </form>
    <% } %>
  </li>
  <% } %>
</ul>
<% } %>

<p><a href="/shops">Back to all shops</a> &middot; <a href="/inventory">Your inventory</a></p>

<script src="/js/shop.js"></script>
<%- include('../partials/footer') %>
