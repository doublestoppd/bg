<%# Main menu. Entries come from src/navigation.js. %>
<nav class="site-nav" aria-label="Main menu">
  <h2 class="site-nav-heading">Navigation</h2>
  <ul>
    <% for (const item of navigation) { %>
    <li>
      <% if (item.method === 'post') { %>
      <form method="post" action="<%= item.href %>">
        <%- include('csrf') %>
        <button type="submit"><%= item.label %></button>
      </form>
      <% } else if (item.image) { %>
      <a href="<%= item.href %>" class="nav-image-link"><img src="<%= item.image %>" alt="<%= item.label %>"></a>
      <% } else { %>
      <a href="<%= item.href %>"><%= item.label %></a>
      <% } %>
    </li>
    <% } %>
  </ul>
</nav>
