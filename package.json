{
  "name": "bg",
  "version": "0.1.0",
  "description": "An original browser-based virtual pet game in the style of the early 2000s.",
  "private": true,
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.js",
    "dev": "node --watch --env-file-if-exists=.env src/server.js",
    "db:migrate": "node --env-file-if-exists=.env scripts/migrate.js",
    "db:reset": "node --env-file-if-exists=.env scripts/db-reset.js",
    "test": "node --env-file-if-exists=.env --test --test-concurrency=1 \"test/**/*.test.js\"",
    "shop-admin": "node --env-file-if-exists=.env scripts/shop-admin.js"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "ejs": "^7.0.1",
    "express": "^5.2.1",
    "express-session": "^1.19.0",
    "pg": "^8.23.1"
  }
}
