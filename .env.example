# Copy this file to .env and fill in your own values. .env is ignored by git.

# PostgreSQL connection for the running game (required).
DATABASE_URL=postgres://blobgarden:blobgarden@127.0.0.1:5432/blobgarden_dev

# A separate database that `npm test` wipes before every test (required for tests).
TEST_DATABASE_URL=postgres://blobgarden:blobgarden@127.0.0.1:5432/blobgarden_test

# Signs login cookies. Required when NODE_ENV=production; use a long random string.
SESSION_SECRET=change-me-before-going-live

# Port the web server listens on.
PORT=3000

# Set to 1 (or the number of proxy hops) when nginx, Caddy or similar sits in front.
# TRUST_PROXY=1

# NODE_ENV=production

# Background jobs (restocks, housekeeping) run in the web process. Set to
# false on additional web-only processes; at least one process must run them.
# SCHEDULER_ENABLED=true
# How often (ms) the scheduler checks whether a shop is due a restock.
# RESTOCK_CHECK_INTERVAL_MS=30000
